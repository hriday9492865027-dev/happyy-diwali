# Database: Neon Serverless PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vercel Blob Storage token for private media storage
BLOB_READ_WRITE_TOKEN=

# Background Removal Provider: "mock" (offline/dev), "removebg", or "replicate" / "birefnet"
BACKGROUND_REMOVAL_PROVIDER=mock
BACKGROUND_REMOVAL_API_KEY=

# Authentication Secret for Protected Admin Access
AUTH_SECRET=
